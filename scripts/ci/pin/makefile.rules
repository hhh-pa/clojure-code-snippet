# snip Pin tool build list (out-of-kit: PIN_ROOT comes from the make
# invocation in .github/actions/pin-tools/action.yml).
#
# Single-file tool, so Pin's makefile.default.rules compiles and
# links it with no special build rules: `make PIN_ROOT=<kit>
# TARGET=intel64` yields obj-intel64/inscount_alloc.so.

TOOL_ROOTS := inscount_alloc
